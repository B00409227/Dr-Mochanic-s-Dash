{
  "rewrites": [
    {
      "source": "/api/dvla/:path*",
      "destination": "https://driver-vehicle-licensing.api.gov.uk/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
